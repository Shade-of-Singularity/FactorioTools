<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
		<InvariantGlobalization>true</InvariantGlobalization>
		<RootNamespace>FactorioTools</RootNamespace>
		<Configurations>Debug;Release;LinuxDebug;LinuxRelease</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Tomlyn.Signed" Version="2.10.1" />
		<PackageReference Include="UniTask" Version="2.5.11" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="FactorioTools" />
	</ItemGroup>

</Project>
